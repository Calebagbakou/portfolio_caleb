{
  "name": "caleb-creative-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API + admin backend for the Caleb Creative portfolio & shop",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",

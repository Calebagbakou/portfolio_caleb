# ============================================================
#  CALEB CREATIVE — variables d'environnement du backend
#  Copier ce fichier en « .env » et adapter les valeurs.
#  NE JAMAIS committer le fichier .env réel.
# ============================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# URL publique du backend (utile pour les liens absolus)
PUBLIC_URL=

# Origines autorisées à appeler l'API depuis un autre domaine
# (ex. portfolio hébergé sur GitHub Pages). Vide = pas de restriction.
CORS_ORIGINS=https://calebagbakou.github.io

# Le backend sert-il aussi le site statique (portfolio + boutique) ?
SERVE_STATIC_SITE=true

# ---------------------------- SÉCURITÉ ----------------------------
# OBLIGATOIRE en production. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_TTL=7d
SESSION_COOKIE=caleb_admin
COOKIE_SECURE=false        # true dès que le site est en HTTPS
COOKIE_SAMESITE=lax        # « none » si l'admin et l'API sont sur des domaines différents

# Compte administrateur créé au premier démarrage (sinon mot de passe généré et affiché)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Caleb AGBAKOU

# --------------------------- BASE DE DONNÉES ---------------------
# SQLite par défaut. Sur un hébergeur, pointer vers un volume persistant :
#   DATABASE_FILE=/data/caleb.db
DATABASE_FILE=

# ------------------------------ MÉDIAS ----------------------------
STORAGE_DRIVER=local       # local | s3
UPLOAD_DIR=                # défaut : server/uploads (volume persistant en prod)
MAX_IMAGE_MB=10
MAX_VIDEO_MB=200
MAX_FILE_MB=20

# Stockage objet (S3 / Cloudflare R2 / DigitalOcean Spaces) — optionnel
# npm i @aws-sdk/client-s3 puis STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ----------------------------- PAIEMENT ---------------------------
# Laisser vide tant qu'aucun prestataire réel n'est branché.
# Voir server/src/lib/payments.js pour ajouter un adaptateur.
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
